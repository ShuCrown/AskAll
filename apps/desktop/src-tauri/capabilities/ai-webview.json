{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ai-webview",
  "description": "AI 聊天页权限：允许远程 AI 站点通过 IPC 回传回复到主窗口",
  "windows": ["main"],
  "webviews": ["ai-*"],
  "remote": {
    "urls": ["https://**/*", "http://**/*"]
  },
  "permissions": [
    "core:default",
    "core:event:default"
  ]
}