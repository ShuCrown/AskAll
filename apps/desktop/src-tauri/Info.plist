<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		macOS 系统「服务」声明：任意 App 中选中文字 → 右键「服务 → 在 AskAll 中提问」。
		服务消息会发送到本应用的 servicesProvider（见 src/os_ask.rs macOS 模块），
		读取选中文字后自动带到桌面端提问。
		NSMessage 必须与 os_ask.rs 中注册的方法选择器完全一致。
	-->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>在 AskAll 中提问</string>
			</dict>
			<key>NSMessage</key>
			<string>askAskAllQuestion:userData:error:</string>
			<key>NSSendTypes</key>
			<array>
				<string>NSStringPboardType</string>
			</array>
			<key>NSServiceApplicationName</key>
			<string>AskAll</string>
		</dict>
	</array>
</dict>
</plist>