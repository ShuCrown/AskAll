{
  "name": "askall-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AskAll 齐问 —— 划词同时向多个 AI 提问。浏览器扩展 + Tauri 桌面端共用同一套 UI。",
  "scripts": {
    "dev:extension": "pnpm --filter @askall/extension dev",
    "dev:extension:firefox": "pnpm --filter @askall/extension dev:firefox",
    "dev:desktop": "pnpm --filter @askall/desktop tauri:dev",
    "build:extension": "pnpm --filter @askall/extension build",
    "build:extension:firefox": "pnpm --filter @askall/extension build:firefox",
    "build:desktop": "pnpm --filter @askall/desktop tauri:build",
    "zip:extension": "pnpm --filter @askall/extension zip",
    "typecheck": "pnpm -r --parallel typecheck",
    "build:web-desktop": "pnpm --filter @askall/desktop build"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=20"
  }
}
